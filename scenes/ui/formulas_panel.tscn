[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/formulas_panel.gd" id="1_formulas"]
[ext_resource type="Script" path="res://scripts/ui/animated_style_button.gd" id="2_anim_style"]
[ext_resource type="Texture2D" path="res://assets/sprites/Sprite-Animacoes/UI/botao_medio/normal/frame_01.png" id="3_medio1"]
[ext_resource type="Texture2D" path="res://assets/sprites/Sprite-Animacoes/UI/botao_medio/normal/frame_02.png" id="4_medio2"]
[ext_resource type="Texture2D" path="res://assets/sprites/Sprite-Animacoes/UI/botao_medio/normal/frame_03.png" id="5_medio3"]
[ext_resource type="Texture2D" path="res://assets/sprites/Sprite-Animacoes/UI/botao_medio/normal/frame_04.png" id="6_medio4"]
[ext_resource type="Texture2D" path="res://assets/sprites/Sprite-Animacoes/UI/botao_medio/apertado/frame_01.png" id="7_medio_pressed"]

[node name="FormulasPanel" type="VBoxContainer"]
process_mode = 3
custom_minimum_size = Vector2(360, 0)
offset_right = 360.0
offset_bottom = 40.0
theme_override_constants/separation = 12
script = ExtResource("1_formulas")

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Fórmulas"
horizontal_alignment = 1

[node name="ScrollContainer" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 320)
layout_mode = 2
size_flags_vertical = 3

[node name="FormulasList" type="VBoxContainer" parent="ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="EcTitle" type="Label" parent="ScrollContainer/FormulasList"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Energia Cinética"

[node name="EcFormula" type="Label" parent="ScrollContainer/FormulasList"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Ec = ½ · m · v²
Unidade: Joules (J)
m = massa (kg), v = velocidade (m/s)"
autowrap_mode = 2

[node name="EcSep" type="HSeparator" parent="ScrollContainer/FormulasList"]
layout_mode = 2

[node name="EpTitle" type="Label" parent="ScrollContainer/FormulasList"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Energia Potencial Gravitacional"

[node name="EpFormula" type="Label" parent="ScrollContainer/FormulasList"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Ep = m · g · h
Unidade: Joules (J)
m = massa (kg), g = 10 m/s², h = altura (m)"
autowrap_mode = 2

[node name="EpSep" type="HSeparator" parent="ScrollContainer/FormulasList"]
layout_mode = 2

[node name="EtTitle" type="Label" parent="ScrollContainer/FormulasList"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Energia Mecânica Total"

[node name="EtFormula" type="Label" parent="ScrollContainer/FormulasList"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Et = Ec + Ep
A energia mecânica total se conserva
quando não há forças dissipativas."
autowrap_mode = 2

[node name="EtSep" type="HSeparator" parent="ScrollContainer/FormulasList"]
layout_mode = 2

[node name="VelTitle" type="Label" parent="ScrollContainer/FormulasList"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Velocidade"

[node name="VelFormula" type="Label" parent="ScrollContainer/FormulasList"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "v = d / t
Unidade: metros por segundo (m/s)
d = distância (m), t = tempo (s)"
autowrap_mode = 2

[node name="VelSep" type="HSeparator" parent="ScrollContainer/FormulasList"]
layout_mode = 2

[node name="GravTitle" type="Label" parent="ScrollContainer/FormulasList"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Gravidade"

[node name="GravFormula" type="Label" parent="ScrollContainer/FormulasList"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "g = 10 m/s²
Aceleração da gravidade usada no jogo:
o valor real na superfície da Terra
(9,8 m/s²) arredondado."
autowrap_mode = 2

[node name="BackButton" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "Voltar"
script = ExtResource("2_anim_style")
normal_frames = Array[Texture2D]([ExtResource("3_medio1"), ExtResource("4_medio2"), ExtResource("5_medio3"), ExtResource("6_medio4")])
pressed_frame = ExtResource("7_medio_pressed")
animation_fps = 2.0
