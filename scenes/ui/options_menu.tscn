[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/options_menu.gd" id="1_options"]

[node name="OptionsMenu" type="PanelContainer"]
process_mode = 3
custom_minimum_size = Vector2(320, 0)
offset_right = 320.0
offset_bottom = 40.0
script = ExtResource("1_options")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="OptionsTitle" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Opções"
horizontal_alignment = 1

[node name="OptionsPlaceholder" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "As opções serão adicionadas aqui."
horizontal_alignment = 1
autowrap_mode = 3

[node name="BackButton" type="Button" parent="VBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "Voltar"
