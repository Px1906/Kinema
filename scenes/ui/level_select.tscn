[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/level_select.gd" id="1_select"]
[ext_resource type="Texture2D" path="res://assets/ui/papel_amassado.jpg" id="2_paper"]
[ext_resource type="Script" path="res://scripts/ui/level_data.gd" id="3_level_data"]

[sub_resource type="Resource" id="Resource_level1"]
script = ExtResource("3_level_data")
path = "res://scenes/levels/teste_cenario.tscn"
title = "Teste de cenário"

[sub_resource type="Resource" id="Resource_level2"]
script = ExtResource("3_level_data")
path = "res://scenes/levels/player_launch_test.tscn"
title = "Teste de lançamento"

[node name="LevelSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_select")
levels = Array[ExtResource("3_level_data")]([SubResource("Resource_level1"), SubResource("Resource_level2")])

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("2_paper")
expand_mode = 1
stretch_mode = 6

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="TitleLabel" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.0588, 0.0902, 0.1647, 1)
theme_override_font_sizes/font_size = 48
text = "Selecionar fase"
horizontal_alignment = 1

[node name="CarouselRow" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="PreviousButton" type="Button" parent="MarginContainer/VBoxContainer/CarouselRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 32
text = "<"

[node name="CardsBox" type="HBoxContainer" parent="MarginContainer/VBoxContainer/CarouselRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 32
alignment = 1

[node name="NextButton" type="Button" parent="MarginContainer/VBoxContainer/CarouselRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 32
text = ">"

[node name="BackButton" type="Button" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 48)
layout_mode = 2
size_flags_horizontal = 4
text = "Voltar"
