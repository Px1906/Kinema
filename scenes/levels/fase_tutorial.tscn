[node name="Dica1_Arremesso" type="Label" parent="Level/Dicas" index="0" unique_id=1159556331]
visible = false
offset_left = 380.0
offset_top = 250.0
offset_right = 1000.0
offset_bottom = 400.0
text = "1. ARREMESSO
Escolha a força e o ângulo e aperte Espaço para lançar.
Cuidado: o chão vermelho encerra a tentativa!"
label_settings = SubResource("LabelSettings_dica")

[node name="Dica2_Paredes" type="Label" parent="Level/Dicas" index="1" unique_id=1519240447]
visible = false
offset_left = 160.0
offset_top = 120.0
offset_right = 900.0
offset_bottom = 230.0
text = "2. PAREDES
A bola quica nas paredes: use-as para subir de plataforma em plataforma."
label_settings = SubResource("LabelSettings_dica")

[node name="Dica3_Corda" type="Label" parent="Level/Dicas" index="2" unique_id=131791730]
visible = false
offset_left = 1260.0
offset_top = -1760.0
offset_right = 1980.0
offset_bottom = -1650.0
text = "3. CORDA
Passe perto do gancho para se prender. Aperte Espaço para soltar."
label_settings = SubResource("LabelSettings_dica")

[node name="Dica4_Descida" type="Label" parent="Level/Dicas" index="3" unique_id=1638136763]
visible = false
offset_left = 2420.0
offset_top = -1480.0
offset_right = 3140.0
offset_bottom = -1340.0
text = "4. DESCIDA
Desça pelo poço e pegue a corda lá embaixo.
Solte na hora certa para cair na plataforma."
label_settings = SubResource("LabelSettings_dica")

[node name="Dica5_Qte" type="Label" parent="Level/Dicas" index="4" unique_id=1351102652]
visible = false
offset_left = 2960.0
offset_top = 32.0
offset_right = 3700.0
offset_bottom = 172.0
text = "5. BARREIRA
Ao chegar perto da barreira amarela, o tempo desacelera.
Responda certo para abri-la!"
label_settings = SubResource("LabelSettings_dica")

[node name="Dica6_Final" type="Label" parent="Level/Dicas" index="5" unique_id=699094629]
visible = false
offset_left = 4500.0
offset_top = -340.0
offset_right = 5240.0
offset_bottom = -200.0
text = "6. DESAFIO FINAL
Corda, barreira e corda de novo.
Depois é só subir até a chegada!"
label_settings = SubResource("LabelSettings_dica")

